{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(rojo build:*)",
      "Bash(rojo sourcemap:*)",
      "Bash(selene:*)",
      "Bash(stylua:*)",
      "Bash(wally install)",
      "Bash(./scripts/check.sh)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./Packages/**)",
      "Edit(./ServerPackages/**)"
    ]
  },
  "enableAllProjectMcpServers": false
}
